  const [error, setError] = useState("");

  const handleLogin = () => {
    if (username === "kedicdz" && password === "DKedic5") {
      alert("Prijava uspešna kot ravnatelj");
      // Preusmeritev na admin nadzorno ploščo
    } else if (username === "ucitelj" && password === "geslo123") {
